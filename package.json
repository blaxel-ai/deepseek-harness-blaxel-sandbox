{
  "name": "@blaxel/dsh-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Blaxel sandbox execution plugin for DeepSeek Harness (DSH)",
  "keywords": [
    "agent-sandbox",
    "blaxel",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote-execution",
    "sandbox"
  ],
  "homepage": "https://github.com/blaxel-ai/deepseek-harness-blaxel-sandbox#readme",
  "bugs": {
    "url": "https://github.com/blaxel-ai/deepseek-harness-blaxel-sandbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blaxel-ai/deepseek-harness-blaxel-sandbox.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "js-yaml": "4.3.1"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./filesystem": {
      "types": "./dist/filesystem.d.ts",
      "import": "./dist/filesystem.js"
    },
    "./subprocess": {
      "types": "./dist/subprocess.d.ts",
      "import": "./dist/subprocess.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./client": "./dist/client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && publint",
    "lint": "oxlint src tests scripts",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@blaxel/core": "0.3.12",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.8"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.8",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.8",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.8",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "js-yaml": "^4.2.0",
    "oxlint": "^1.11.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "publint": "^0.3.12",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
