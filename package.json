{
  "name": "@blaxel/dsh-sandbox",
  "version": "0.1.1",
  "description": "Blaxel sandbox execution plugin for DeepSeek Harness (DSH)",
  "keywords": [
    "agent-sandbox",
    "blaxel",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote-execution",
    "sandbox"
  ],
  "homepage": "https://github.com/blaxel-ai/deepseek-harness-blaxel-sandbox#readme",
  "bugs": {
    "url": "https://github.com/blaxel-ai/deepseek-harness-blaxel-sandbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blaxel-ai/deepseek-harness-blaxel-sandbox.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "js-yaml": "4.3.1",
      "fast-uri": "3.1.7",
      "qs": "6.16.0"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./filesystem": {
      "types": "./dist/filesystem.d.ts",
      "import": "./dist/filesystem.js"
    },
    "./subprocess": {
      "types": "./dist/subprocess.d.ts",
      "import": "./dist/subprocess.js"
    },
    "./filesystem-routing": {
      "types": "./dist/filesystem-routing.d.ts",
      "import": "./dist/filesystem-routing.js"
    },
    "./subprocess-routing": {
      "types": "./dist/subprocess-routing.d.ts",
      "import": "./dist/subprocess-routing.js"
    },
    "./session-runtime": {
      "types": "./dist/session-runtime.d.ts",
      "import": "./dist/session-runtime.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./client": "./dist/client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "GUIDE.md",
    "llms.txt",
    "docs/calibrator-roundtrip-dogfood.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && publint",
    "lint": "oxlint src tests scripts",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@apify/mcpc": "0.6.0",
    "@blaxel/core": "0.3.12",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-fs-sandbox": "0.1.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "skills": "1.5.23",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/qs": "^6.15.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "fast-uri": "^3.1.7",
    "js-yaml": "^4.2.0",
    "oxlint": "^1.11.2",
    "publint": "^0.3.12",
    "qs": "^6.16.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
